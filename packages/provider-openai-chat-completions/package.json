{
  "name": "@litellm-bench/provider-openai-chat-completions",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixture": "./fixtures/nonstream.json",
    "./fixture-streaming": "./fixtures/streaming.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm typecheck",
    "fixtures:generate": "pnpm build && node scripts/generate-fixtures.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@litellm-bench/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
