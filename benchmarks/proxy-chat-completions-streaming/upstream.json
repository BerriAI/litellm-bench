{
  "$schema": "../../schemas/current/upstream.schema.json",
  "version": 2,
  "operations": [
    {
      "id": "chat-stream",
      "operation": "chat-completions",
      "method": "POST",
      "path": "/v1/chat/completions",
      "expect": {
        "model": "bench-model",
        "messages": [{ "role": "user", "content": "Hello" }],
        "stream": true
      },
      "body_match": "exact",
      "expect_headers": {
        "authorization": "Bearer sk-mock",
        "content-type": "application/json"
      },
      "response": {
        "kind": "sse",
        "timing": { "first_event_delay_ms": 10, "event_interval_ms": 5 },
        "events": [
          {
            "data": {
              "id": "chatcmpl-stream",
              "object": "chat.completion.chunk",
              "created": 1,
              "model": "bench-model",
              "choices": [
                {
                  "index": 0,
                  "delta": { "role": "assistant", "content": "" },
                  "finish_reason": null
                }
              ]
            }
          },
          {
            "data": {
              "id": "chatcmpl-stream",
              "object": "chat.completion.chunk",
              "created": 1,
              "model": "bench-model",
              "choices": [{ "index": 0, "delta": { "content": "mock " }, "finish_reason": null }]
            }
          },
          {
            "data": {
              "id": "chatcmpl-stream",
              "object": "chat.completion.chunk",
              "created": 1,
              "model": "bench-model",
              "choices": [
                { "index": 0, "delta": { "content": "streaming " }, "finish_reason": null }
              ]
            }
          },
          {
            "data": {
              "id": "chatcmpl-stream",
              "object": "chat.completion.chunk",
              "created": 1,
              "model": "bench-model",
              "choices": [{ "index": 0, "delta": { "content": "chat " }, "finish_reason": null }]
            }
          },
          {
            "data": {
              "id": "chatcmpl-stream",
              "object": "chat.completion.chunk",
              "created": 1,
              "model": "bench-model",
              "choices": [{ "index": 0, "delta": { "content": "response" }, "finish_reason": null }]
            }
          },
          {
            "data": {
              "id": "chatcmpl-stream",
              "object": "chat.completion.chunk",
              "created": 1,
              "model": "bench-model",
              "choices": [{ "index": 0, "delta": {}, "finish_reason": "stop" }]
            }
          },
          { "data": "[DONE]" }
        ]
      }
    }
  ]
}
